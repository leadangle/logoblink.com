{
  schema: {
    files: '*.gql',
  },
  query: {
    files: [ /* define file paths which you'd like the gql parser to watch and give autocomplete suggestions for */
      {
        match: ['src/**/*.js', 'gatsby-node.js'], // for js
        parser: ['EmbeddedQueryParser', { startTag: 'graphql\\(?`', endTag: '\\)?`' }],
      },
    ],
  },
}
